From 8e733560bda61a7b586cae98410e69f9cc70f2eb Mon Sep 17 00:00:00 2001
From: Joris OFFOUGA <offougajoris@icloud.com>
Date: Sun, 27 Sep 2026 00:25:17 +0200
Subject: [PATCH 5/5] imx8mp-debix-model-a: add USB PHY and controller
 configurations

Signed-off-by: Joris OFFOUGA <offougajoris@icloud.com>
---
 arch/arm/dts/imx8mp-debix-model-a.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm/dts/imx8mp-debix-model-a.dts b/arch/arm/dts/imx8mp-debix-model-a.dts
index 67534a7e9aa..a83e8624436 100644
--- a/arch/arm/dts/imx8mp-debix-model-a.dts
+++ b/arch/arm/dts/imx8mp-debix-model-a.dts
@@ -254,6 +254,19 @@
 	status = "okay";
 };
 
+&usb3_phy0 {
+	status = "okay";
+};
+
+&usb3_0 {
+	status = "okay";
+};
+
+&usb_dwc3_0 {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
 /* SD Card */
 &usdhc2 {
 	pinctrl-names = "default", "state_100mhz", "state_200mhz";
-- 
