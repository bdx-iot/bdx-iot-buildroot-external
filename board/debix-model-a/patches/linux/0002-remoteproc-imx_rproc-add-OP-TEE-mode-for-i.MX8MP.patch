From 8807c3569c40a7e86b20f24b48c8c1312b260471 Mon Sep 17 00:00:00 2001
From: Joris OFFOUGA <offougajoris@icloud.com>
Date: Tue, 6 Oct 2026 00:11:28 +0200
Subject: [PATCH] remoteproc: imx_rproc: add OP-TEE mode for i.MX8MP

With "fsl,imx8mp-cm7-tee", let the OP-TEE remoteproc TA authenticate and
load the Cortex-M7 firmware, and start and stop the M7, instead of Linux
loading the ELF and TF-A starting the core.

The firmware is an ELF signed with OP-TEE scripts/sign_rproc_fw.py. The TA
checks the signature with the public key built into OP-TEE
(CFG_IMX_REMOTEPROC=y, RPROC_SIGN_KEY), loads the segments it can hash
check into the M7 memories, and returns the address of the resource table
it found in the ELF. Linux keeps handling the carveouts, vrings, mailbox
and trace buffer as in the other modes, on that resource table.

After a stop, the TA must load the firmware again: .load does it on
recovery, and .unprepare asks the TA to release the firmware, which clears
the M7 memories.

Signed-off-by: Joris OFFOUGA <offougajoris@icloud.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/remoteproc/Kconfig     |   1 +
 drivers/remoteproc/imx_rproc.c | 344 ++++++++++++++++++++++++++++++++-
 drivers/remoteproc/imx_rproc.h |   2 +
 3 files changed, 341 insertions(+), 6 deletions(-)

diff --git a/drivers/remoteproc/Kconfig b/drivers/remoteproc/Kconfig
index aba47cf..c9fdafd 100644
--- a/drivers/remoteproc/Kconfig
+++ b/drivers/remoteproc/Kconfig
@@ -27,6 +27,7 @@ config IMX_REMOTEPROC
 	tristate "i.MX remoteproc support"
 	depends on ARCH_MXC
 	depends on HAVE_ARM_SMCCC
+	depends on TEE || !TEE
 	select MAILBOX
 	help
 	  Say y here to support iMX's remote processors via the remote
diff --git a/drivers/remoteproc/imx_rproc.c b/drivers/remoteproc/imx_rproc.c
index 09d02f7..04c1d6c 100644
--- a/drivers/remoteproc/imx_rproc.c
+++ b/drivers/remoteproc/imx_rproc.c
@@ -23,6 +23,8 @@
 #include <linux/reboot.h>
 #include <linux/regmap.h>
 #include <linux/remoteproc.h>
+#include <linux/tee_drv.h>
+#include <linux/uuid.h>
 #include <linux/workqueue.h>
 
 #include "remoteproc_elf_helpers.h"
@@ -75,6 +77,25 @@
 
 #define IMX_SC_IRQ_GROUP_REBOOTED	5
 
+/*
+ * OP-TEE remoteproc TA, see optee_os ta/remoteproc/include/ta_remoteproc.h.
+ * Every command takes the remote processor ID in params[0].value.a.
+ */
+static const uuid_t imx_rproc_ta_uuid =
+	UUID_INIT(0x80a4c275, 0x0a47, 0x4905,
+		  0x82, 0x85, 0x14, 0x86, 0xa9, 0x77, 0x1a, 0x08);
+
+#define IMX_RPROC_TEE_RPROC_ID		0
+#define IMX_RPROC_TEE_FW_MAGIC		0x3543A468
+
+#define TA_RPROC_CMD_LOAD_FW		1
+#define TA_RPROC_CMD_START_FW		2
+#define TA_RPROC_CMD_STOP_FW		3
+#define TA_RPROC_CMD_GET_RSC_TABLE	4
+#define TA_RPROC_CMD_RELEASE_FW		6
+
+#define TA_RPROC_NUM_PARAMS		4
+
 /**
  * struct imx_rproc_mem - slim internal memory structure
  * @cpu_addr: MPU virtual address of the memory region
@@ -121,6 +142,12 @@ struct imx_rproc {
 	u32				core_index;
 	struct dev_pm_domain_list	*pd_list;
 	u32				startup_delay;
+	struct tee_context		*tee_ctx;
+	u32				tee_session;
+	bool				tee_loaded;	/* TA firmware loaded */
+	bool				tee_release;	/* TA firmware to release */
+	void __iomem			*tee_rsc_table;
+	bool				tee_rsc_iomap;	/* tee_rsc_table ioremapped */
 };
 
 static const struct imx_rproc_att imx_rproc_att_imx95_m7[] = {
@@ -320,6 +347,12 @@ static const struct imx_rproc_dcfg imx_rproc_cfg_imx8mn = {
 	.method		= IMX_RPROC_SMC,
 };
 
+static const struct imx_rproc_dcfg imx_rproc_cfg_imx8mp_tee = {
+	.att		= imx_rproc_att_imx8mn,
+	.att_size	= ARRAY_SIZE(imx_rproc_att_imx8mn),
+	.method		= IMX_RPROC_TEE,
+};
+
 static const struct imx_rproc_dcfg imx_rproc_cfg_imx8mq = {
 	.src_reg	= IMX7D_SRC_SCR,
 	.src_mask	= IMX7D_M4_RST_MASK,
@@ -387,6 +420,39 @@ static const struct imx_rproc_dcfg imx_rproc_cfg_imx95_m7 = {
 	.method		= IMX_RPROC_SMC,
 };
 
+static int imx_rproc_tee_invoke(struct imx_rproc *priv, u32 cmd,
+				struct tee_param *param)
+{
+	struct tee_ioctl_invoke_arg arg = {
+		.func = cmd,
+		.session = priv->tee_session,
+		.num_params = TA_RPROC_NUM_PARAMS,
+	};
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_TEE))
+		return -EOPNOTSUPP;
+
+	param[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT;
+	param[0].u.value.a = IMX_RPROC_TEE_RPROC_ID;
+
+	ret = tee_client_invoke_func(priv->tee_ctx, &arg, param);
+	if (ret < 0 || arg.ret) {
+		dev_err(priv->dev, "remoteproc TA command %u failed: %d, 0x%x\n",
+			cmd, ret, arg.ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+static int imx_rproc_tee_cmd(struct imx_rproc *priv, u32 cmd)
+{
+	struct tee_param param[TA_RPROC_NUM_PARAMS] = { };
+
+	return imx_rproc_tee_invoke(priv, cmd, param);
+}
+
 static int imx_rproc_start(struct rproc *rproc)
 {
 	struct imx_rproc *priv = rproc->priv;
@@ -421,6 +487,14 @@ static int imx_rproc_start(struct rproc *rproc)
 	case IMX_RPROC_SCU_API:
 		ret = imx_sc_pm_cpu_start(priv->ipc_handle, priv->rsrc_id, true, priv->entry);
 		break;
+	case IMX_RPROC_TEE:
+		ret = clk_prepare_enable(priv->clk_audio);
+		if (ret)
+			dev_err(dev, "Failed to enable audio clk!\n");
+		ret = imx_rproc_tee_cmd(priv, TA_RPROC_CMD_START_FW);
+		if (ret)
+			clk_disable_unprepare(priv->clk_audio);
+		break;
 	default:
 		return -EOPNOTSUPP;
 	}
@@ -467,6 +541,14 @@ static int imx_rproc_stop(struct rproc *rproc)
 	case IMX_RPROC_SCU_API:
 		ret = imx_sc_pm_cpu_start(priv->ipc_handle, priv->rsrc_id, false, priv->entry);
 		break;
+	case IMX_RPROC_TEE:
+		ret = imx_rproc_tee_cmd(priv, TA_RPROC_CMD_STOP_FW);
+		if (ret)
+			break;
+		/* The TA must load the firmware again before a restart */
+		priv->tee_loaded = false;
+		clk_disable_unprepare(priv->clk_audio);
+		break;
 	default:
 		return -EOPNOTSUPP;
 	}
@@ -759,6 +841,240 @@ static const struct rproc_ops imx_rproc_ops = {
 	.get_boot_addr	= imx_rproc_get_boot_addr,
 };
 
+static int imx_rproc_tee_sanity_check(struct rproc *rproc,
+				      const struct firmware *fw)
+{
+	__le32 magic;
+
+	/* The remoteproc TA authenticates the rest of the signed image */
+	if (fw->size < sizeof(magic))
+		goto err;
+
+	memcpy(&magic, fw->data, sizeof(magic));
+	if (le32_to_cpu(magic) == IMX_RPROC_TEE_FW_MAGIC)
+		return 0;
+
+err:
+	dev_err(&rproc->dev, "Not a signed firmware image (sign_rproc_fw.py)\n");
+	return -EINVAL;
+}
+
+static int imx_rproc_tee_load_fw(struct rproc *rproc,
+				 const struct firmware *fw)
+{
+	struct imx_rproc *priv = rproc->priv;
+	struct tee_param param[TA_RPROC_NUM_PARAMS] = { };
+	struct tee_shm *shm;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_TEE))
+		return -EOPNOTSUPP;
+
+	if (priv->tee_loaded)
+		return 0;
+
+	shm = tee_shm_alloc_kernel_buf(priv->tee_ctx, fw->size);
+	if (IS_ERR(shm))
+		return PTR_ERR(shm);
+
+	memcpy(tee_shm_get_va(shm, 0), fw->data, fw->size);
+
+	param[1].attr = TEE_IOCTL_PARAM_ATTR_TYPE_MEMREF_INPUT;
+	param[1].u.memref.shm = shm;
+	param[1].u.memref.size = fw->size;
+
+	ret = imx_rproc_tee_invoke(priv, TA_RPROC_CMD_LOAD_FW, param);
+	tee_shm_free(shm);
+	if (ret)
+		return ret;
+
+	priv->tee_loaded = true;
+	priv->tee_release = true;
+
+	return 0;
+}
+
+static void __iomem *imx_rproc_tee_map(struct imx_rproc *priv, u64 pa,
+				       size_t size)
+{
+	int i;
+
+	/* The resource table is usually in a TCM, already mapped */
+	for (i = 0; i < IMX_RPROC_MEM_MAX; i++) {
+		struct imx_rproc_mem *mem = &priv->mem[i];
+
+		if (pa >= mem->sys_addr &&
+		    pa + size <= mem->sys_addr + mem->size)
+			return mem->cpu_addr + (pa - mem->sys_addr);
+	}
+
+	priv->tee_rsc_iomap = true;
+
+	return ioremap_wc(pa, size);
+}
+
+static void imx_rproc_tee_unmap_rsc_table(struct imx_rproc *priv)
+{
+	if (priv->tee_rsc_iomap && priv->tee_rsc_table)
+		iounmap(priv->tee_rsc_table);
+
+	priv->tee_rsc_table = NULL;
+	priv->tee_rsc_iomap = false;
+}
+
+/*
+ * Authenticate and load the firmware through the remoteproc TA, then get
+ * the resource table the TA found in the loaded firmware.
+ */
+static int imx_rproc_tee_parse_fw(struct rproc *rproc,
+				  const struct firmware *fw)
+{
+	struct imx_rproc *priv = rproc->priv;
+	struct tee_param param[TA_RPROC_NUM_PARAMS] = { };
+	struct resource_table *table;
+	size_t size;
+	u64 pa;
+	int ret;
+
+	ret = imx_rproc_tee_load_fw(rproc, fw);
+	if (ret)
+		return ret;
+
+	param[1].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_OUTPUT;
+	param[2].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_OUTPUT;
+
+	ret = imx_rproc_tee_invoke(priv, TA_RPROC_CMD_GET_RSC_TABLE, param);
+	if (ret)
+		return ret;
+
+	pa = (param[1].u.value.b << 32) | lower_32_bits(param[1].u.value.a);
+	size = (param[2].u.value.b << 32) | lower_32_bits(param[2].u.value.a);
+	if (!size) {
+		dev_info(&rproc->dev, "No resource table in firmware\n");
+		return 0;
+	}
+
+	imx_rproc_tee_unmap_rsc_table(priv);
+	priv->tee_rsc_table = imx_rproc_tee_map(priv, pa, size);
+	if (!priv->tee_rsc_table) {
+		dev_err(&rproc->dev, "Unable to map resource table %#llx\n", pa);
+		return -ENOMEM;
+	}
+
+	table = kmalloc(size, GFP_KERNEL);
+	if (!table)
+		return -ENOMEM;
+
+	memcpy_fromio(table, priv->tee_rsc_table, size);
+
+	rproc->cached_table = table;
+	rproc->table_ptr = table;
+	rproc->table_sz = size;
+
+	return 0;
+}
+
+static struct resource_table *
+imx_rproc_tee_find_loaded_rsc_table(struct rproc *rproc,
+				    const struct firmware *fw)
+{
+	struct imx_rproc *priv = rproc->priv;
+
+	return (__force struct resource_table *)priv->tee_rsc_table;
+}
+
+static int imx_rproc_tee_unprepare(struct rproc *rproc)
+{
+	struct imx_rproc *priv = rproc->priv;
+
+	imx_rproc_tee_unmap_rsc_table(priv);
+
+	/* Clear the remote processor memories */
+	if (priv->tee_release &&
+	    !imx_rproc_tee_cmd(priv, TA_RPROC_CMD_RELEASE_FW)) {
+		priv->tee_release = false;
+		priv->tee_loaded = false;
+	}
+
+	return 0;
+}
+
+/*
+ * OP-TEE authenticates and loads the firmware (signed by sign_rproc_fw.py),
+ * starts and stops the remote processor.
+ */
+static const struct rproc_ops imx_rproc_tee_ops = {
+	.prepare	= imx_rproc_prepare,
+	.unprepare	= imx_rproc_tee_unprepare,
+	.start		= imx_rproc_start,
+	.stop		= imx_rproc_stop,
+	.kick		= imx_rproc_kick,
+	.da_to_va	= imx_rproc_da_to_va,
+	/* Load again after a stop, on recovery */
+	.load		= imx_rproc_tee_load_fw,
+	.parse_fw	= imx_rproc_tee_parse_fw,
+	.find_loaded_rsc_table = imx_rproc_tee_find_loaded_rsc_table,
+	.sanity_check	= imx_rproc_tee_sanity_check,
+};
+
+static int imx_rproc_tee_match(struct tee_ioctl_version_data *ver,
+			       const void *data)
+{
+	return ver->impl_id == TEE_IMPL_ID_OPTEE;
+}
+
+static int imx_rproc_tee_init(struct imx_rproc *priv)
+{
+	struct tee_param param[TA_RPROC_NUM_PARAMS] = { };
+	struct tee_ioctl_open_session_arg arg = { };
+	struct device *dev = priv->dev;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_TEE))
+		return dev_err_probe(dev, -EOPNOTSUPP, "CONFIG_TEE is disabled\n");
+
+	priv->tee_ctx = tee_client_open_context(NULL, imx_rproc_tee_match,
+						NULL, NULL);
+	if (IS_ERR(priv->tee_ctx)) {
+		ret = PTR_ERR(priv->tee_ctx);
+		priv->tee_ctx = NULL;
+		/* OP-TEE driver not probed yet */
+		if (ret == -ENOENT)
+			ret = -EPROBE_DEFER;
+		return dev_err_probe(dev, ret, "Failed to open TEE context\n");
+	}
+
+	export_uuid(arg.uuid, &imx_rproc_ta_uuid);
+	arg.clnt_login = TEE_IOCTL_LOGIN_PUBLIC;
+	arg.num_params = TA_RPROC_NUM_PARAMS;
+
+	param[0].attr = TEE_IOCTL_PARAM_ATTR_TYPE_VALUE_INPUT;
+	param[0].u.value.a = IMX_RPROC_TEE_RPROC_ID;
+
+	ret = tee_client_open_session(priv->tee_ctx, &arg, param);
+	if (ret < 0 || arg.ret) {
+		dev_err(dev, "Failed to open remoteproc TA session: %d, 0x%x\n",
+			ret, arg.ret);
+		tee_client_close_context(priv->tee_ctx);
+		priv->tee_ctx = NULL;
+		return ret < 0 ? ret : -ENODEV;
+	}
+
+	priv->tee_session = arg.session;
+
+	return 0;
+}
+
+static void imx_rproc_tee_exit(struct imx_rproc *priv)
+{
+	if (!IS_ENABLED(CONFIG_TEE) || !priv->tee_ctx)
+		return;
+
+	tee_client_close_session(priv->tee_ctx, priv->tee_session);
+	tee_client_close_context(priv->tee_ctx);
+	priv->tee_ctx = NULL;
+}
+
 static int imx_rproc_addr_init(struct imx_rproc *priv,
 			       struct platform_device *pdev)
 {
@@ -991,6 +1307,9 @@ static int imx_rproc_detect_mode(struct imx_rproc *priv)
 	case IMX_RPROC_NONE:
 		priv->rproc->state = RPROC_DETACHED;
 		return 0;
+	case IMX_RPROC_TEE:
+		/* OP-TEE keeps the remote core stopped until Linux starts it */
+		return 0;
 	case IMX_RPROC_SMC:
 		arm_smccc_smc(IMX_SIP_RPROC, IMX_SIP_RPROC_STARTED, 0, 0, 0, 0, 0, 0, &res);
 		if (res.a0)
@@ -1157,26 +1476,35 @@ static int imx_rproc_probe(struct platform_device *pdev)
 	const struct imx_rproc_dcfg *dcfg;
 	int ret;
 
+	dcfg = of_device_get_match_data(dev);
+	if (!dcfg)
+		return -EINVAL;
+
 	/* set some other name then imx */
-	rproc = devm_rproc_alloc(dev, "imx-rproc", &imx_rproc_ops,
+	rproc = devm_rproc_alloc(dev, "imx-rproc",
+				 dcfg->method == IMX_RPROC_TEE ?
+				 &imx_rproc_tee_ops : &imx_rproc_ops,
 				 NULL, sizeof(*priv));
 	if (!rproc)
 		return -ENOMEM;
 
-	dcfg = of_device_get_match_data(dev);
-	if (!dcfg)
-		return -EINVAL;
-
 	priv = rproc->priv;
 	priv->rproc = rproc;
 	priv->dcfg = dcfg;
 	priv->dev = dev;
 
+	if (dcfg->method == IMX_RPROC_TEE) {
+		ret = imx_rproc_tee_init(priv);
+		if (ret)
+			return ret;
+	}
+
 	dev_set_drvdata(dev, rproc);
 	priv->workqueue = create_workqueue(dev_name(dev));
 	if (!priv->workqueue) {
 		dev_err(dev, "cannot create workqueue\n");
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto err_put_tee;
 	}
 
 	INIT_WORK(&priv->rproc_work, imx_rproc_vq_work);
@@ -1246,6 +1574,8 @@ static int imx_rproc_probe(struct platform_device *pdev)
 	imx_rproc_free_mbox(rproc);
 err_put_wkq:
 	destroy_workqueue(priv->workqueue);
+err_put_tee:
+	imx_rproc_tee_exit(priv);
 
 	return ret;
 }
@@ -1260,6 +1590,7 @@ static void imx_rproc_remove(struct platform_device *pdev)
 	imx_rproc_put_scu(rproc);
 	imx_rproc_free_mbox(rproc);
 	destroy_workqueue(priv->workqueue);
+	imx_rproc_tee_exit(priv);
 }
 
 static const struct of_device_id imx_rproc_of_match[] = {
@@ -1272,6 +1603,7 @@ static const struct of_device_id imx_rproc_of_match[] = {
 	{ .compatible = "fsl,imx8mp-cm7", .data = &imx_rproc_cfg_imx8mn },
 	{ .compatible = "fsl,imx8mn-cm7-mmio", .data = &imx_rproc_cfg_imx8mn_mmio },
 	{ .compatible = "fsl,imx8mp-cm7-mmio", .data = &imx_rproc_cfg_imx8mn_mmio },
+	{ .compatible = "fsl,imx8mp-cm7-tee", .data = &imx_rproc_cfg_imx8mp_tee },
 	{ .compatible = "fsl,imx8qxp-cm4", .data = &imx_rproc_cfg_imx8qxp },
 	{ .compatible = "fsl,imx8qm-cm4", .data = &imx_rproc_cfg_imx8qm },
 	{ .compatible = "fsl,imx8ulp-cm33", .data = &imx_rproc_cfg_imx8ulp },
diff --git a/drivers/remoteproc/imx_rproc.h b/drivers/remoteproc/imx_rproc.h
index 17a7d05..a3fc4f2 100644
--- a/drivers/remoteproc/imx_rproc.h
+++ b/drivers/remoteproc/imx_rproc.h
@@ -24,6 +24,8 @@ enum imx_rproc_method {
 	IMX_RPROC_SMC,
 	/* Through System Control Unit API */
 	IMX_RPROC_SCU_API,
+	/* Through the OP-TEE remoteproc TA, which also loads the firmware */
+	IMX_RPROC_TEE,
 };
 
 /* dcfg flags */
-- 
