 * Extra nodes appended to U-Boot's upstream nxp/imx/imx7s-warp.dts through
 * CONFIG_DEVICE_TREE_INCLUDES (see uboot.fragment).
 */

/ {
	leds {
		compatible = "gpio-leds";

		system {
			label = "boot";
			gpios = <&mcp23008 0 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
};

&i2c3 {
	mcp23008: mcp23008@20 {
		compatible = "microchip,mcp23008";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x20>;
	};

	lm75a@4b {
		compatible = "national,lm75a";
		reg = <0x4b>;
	};

	rtc@6f {
		compatible = "microchip,mcp7940x";
		reg = <0x6f>;
	};
};

&gpio7 {
	rst_mikrobus {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};
